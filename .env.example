# Αντίγραψε αυτό το αρχείο σε .env και συμπλήρωσε τα keys.
# Το .env ΔΕΝ ανεβαίνει στο git (βλ. .gitignore).

# AbuseIPDB API key (free tier ~1000 checks/μέρα)
ABUSEIPDB_API_KEY=

# Spamhaus DQS key (Data Query Service) — ΠΡΟΤΙΜΩΜΕΝΟ. Free signup:
# https://www.spamhaus.com/free-trial/sign-up-for-a-free-data-query-service-account/
# Δουλεύει μέσω οποιουδήποτε resolver (~300k queries/μέρα).
SPAMHAUS_DQS_KEY=

# (Προαιρετικό fallback) custom resolver IP για τα public zones — ΜΟΝΟ αν δεν
# έχεις DQS key. ΟΧΙ public resolver (8.8.8.8 κ.λπ.).
SPAMHAUS_RESOLVER=

# MaxMind GeoLite2 — δωρεάν signup: https://www.maxmind.com/en/geolite2/signup
# Χρειάζεται μόνο για να ΚΑΤΕΒΑΣΕΙΣ τα .mmdb (scripts/download_geolite.py),
# όχι σε κάθε query.
MAXMIND_LICENSE_KEY=
